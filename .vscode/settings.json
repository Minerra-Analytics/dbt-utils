{
    // Editor settings
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.wordWrap": "on",
    "editor.minimap.enabled": false,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.tabSize": 2,
    "editor.rulers": [
        80,
        100
    ],
    "editor.suggestSelection": "first",
    "editor.inlineSuggest.enabled": true,
    "editor.quickSuggestions": {
        "strings": true
    },
    // File settings
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.autoSave": "onFocusChange",
    "files.associations": {
        "*.sql": "jinja-sql",
        "*.yml": "jinja-yaml",
        "*.yaml": "jinja-yaml",
        "*.md": "jinja-md"
    },
    // DBT settings
    "dbt.queryLimit": 500,
    "dbt.enableNewLineagePanel": true,
    "dbt.altimateInstanceName": "minerra",
    "dbt.enableNewQueryPanel": true,
    "dbt.sqlFormatter": "sqlfmt",
    // Language specific settings
    // SQL-specific settings
    "[sql]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[jinja-sql]": {
        "editor.defaultFormatter": "innoverio.vscode-dbt-power-user",
        "editor.formatOnSave": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[yaml]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[jinja-yaml]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    // Git settings
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": false,
    "git.ignoreRebaseWarning": true,
    // Terminal settings
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.fontSize": 12,
    // Environment variables for this workspace
    "terminal.integrated.env.linux": {
        "target": "postgres",
        "POSTGRES_HOST": "localhost",
        "POSTGRES_USER": "root",
        "DBT_ENV_SECRET_POSTGRES_PASS": "password",
        "POSTGRES_PORT": "5432",
        "POSTGRES_DATABASE": "dbt_utils_test",
        "POSTGRES_SCHEMA": "dbt_utils_integration_tests_postgres"
    },
    // Explorer settings
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    // Workbench settings
    "workbench.editor.enablePreview": false,
    // Remote settings
    "remote.autoForwardPortsSource": "hybrid",
    "security.allowedUNCHosts": [
        "wsl.localhost"
    ],
    // SQL settings
    "sqltools.useNodeRuntime": false,
    // YAML settings
    "yaml.format.enable": true,
    "yaml.validate": true,
    // YAML Schemas for dbt
    "yaml.schemas": {
        "https://raw.githubusercontent.com/dbt-labs/dbt-jsonschema/main/schemas/latest/dbt_yml_files-latest.json": [
            "/**/*.yml",
            "!profiles.yml",
            "!dbt_project.yml",
            "!packages.yml",
            "!selectors.yml",
            "!profile_template.yml",
            "!package-lock.yml"
        ],
        "https://raw.githubusercontent.com/dbt-labs/dbt-jsonschema/main/schemas/latest/dbt_project-latest.json": [
            "dbt_project.yml"
        ],
        "https://raw.githubusercontent.com/dbt-labs/dbt-jsonschema/main/schemas/latest/selectors-latest.json": [
            "selectors.yml"
        ],
        "https://raw.githubusercontent.com/dbt-labs/dbt-jsonschema/main/schemas/latest/packages-latest.json": [
            "packages.yml"
        ]
    },
    // Search exclusions
    "search.exclude": {
        "**/target": true,
        "**/dbt_packages": true,
        "**/logs": true
    },
    "yaml.customTags": [],
    "sqltools.connections": [
        {
            "previewLimit": 50,
            "server": "localhost",
            "port": 5432,
            "driver": "PostgreSQL",
            "name": "dbt utils testing",
            "database": "dbt_utils_test",
            "username": "root",
            "password": "password"
        }
    ]
}
